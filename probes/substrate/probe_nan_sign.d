// probes/substrate/probe_nan_sign.d — the NaN sign rule, measured.
//
// WHY. substrate/include/eil/math.hpp has carried `canonical_nan(v)` since phase 0,
// whose comment says Phobos' domain errors "return a *positive* NaN" while glibc's
// return a negative one, and routes every NaN-producing result through it. Two things
// were wrong about that, both found while closing geom_surface_aopatch:
//
//   1. libstdc++'s std::numeric_limits<double>::quiet_NaN() on x86-64 is
//      0xfff8000000000000 — it has the SIGN BIT SET. So the helper that was written
//      to force "+nan" has been forcing "-nan" all along, and the divergence it
//      claims to remove was never removed.
//   2. The rule is not one polarity. Phobos distinguishes a NaN that arrives as an
//      operand from a NaN generated by a domain error on a finite operand, and it
//      differs per function even for the second kind.
//
// Measured here, by building the operands from raw bit patterns (0/0 is not a way to
// make a chosen NaN — it always yields the negative default NaN):
//
//   NaN in            sqrt, log, pow, tanh: sign propagated unchanged
//   finite in, error  sqrt/log/log10/pow: +nan ; asin/acos: -nan
//   fabs(nan)                             : sign cleared
//   0.0/0.0                               : -nan (hardware default, same in C)
//
// glibc agrees on the propagation case and disagrees on the domain-error case for
// sqrt/log/pow (it gives -nan where Phobos gives +nan). So a port that canonicalises
// unconditionally corrupts the propagation case, and one that canonicalises to
// quiet_NaN() gets the polarity backwards in both. This corpus pins all of it.
//
// Build and capture:
//   cd /home/tang/packages/Eilmer
//   /home/tang/packages/dlang/bin/ldc2 probes/substrate/probe_nan_sign.d \
//     -of=/tmp/probe_nansign && /tmp/probe_nansign \
//     > baselines/e587b235/probes/substrate_nan_sign.txt
import std.format;
import std.math;
import std.stdio;

string b(double x) { return format("%016x", *cast(ulong*)&x); }

double mk(ulong u) { return *cast(double*)&u; }

// A NaN operand must keep its own sign through a function; a finite operand that
// triggers a domain error gets the function's own NaN. Both printed as bits.
void probe_fn(const char[] name, double delegate(double) f)
{
    const double pp = mk(0x7ff8000000000000UL);   // positive quiet NaN
    const double np = mk(0xfff8000000000000UL);   // negative quiet NaN
    const double ps = mk(0x7ff4000000000000UL);   // positive SIGNALLING NaN
    writefln("%-6s in=+nan    out=%s", name, b(f(pp)));
    writefln("%-6s in=-nan    out=%s", name, b(f(np)));
    writefln("%-6s in=s_nan+  out=%s", name, b(f(ps)));
    writefln("%-6s in=-2.0    out=%s", name, b(f(-2.0)));
    writefln("%-6s in=+2.0    out=%s", name, b(f(2.0)));
    writefln("%-6s in=-0.25   out=%s", name, b(f(-0.25)));
}

void main()
{
    probe_fn("sqrt", (double x) => sqrt(x));
    probe_fn("log", (double x) => log(x));
    probe_fn("log10", (double x) => log10(x));
    probe_fn("log2", (double x) => log2(x));
    probe_fn("asin", (double x) => asin(x));
    probe_fn("acos", (double x) => acos(x));
    probe_fn("tanh", (double x) => tanh(x));
    probe_fn("sin", (double x) => sin(x));
    probe_fn("fabs", (double x) => fabs(x));
    probe_fn("exp", (double x) => exp(x));

    // pow with a fixed exponent, since its domain error is exponent-dependent.
    foreach (x; [mk(0x7ff8000000000000UL), mk(0xfff8000000000000UL), -2.0, -8.0]) {
        writefln("pow2  in=%s out=%s", b(x), b(pow(x, 2.0)));
        writefln("powH  in=%s out=%s", b(x), b(pow(x, 0.5)));
        writefln("powT  in=%s out=%s", b(x), b(pow(x, 1.0 / 3.0)));
    }

    // Hardware default NaN, which is what a raw division 0.0/0.0 yields in both.
    double z = 0.0;
    writefln("div00 bits=%s", b(z / z));
    writefln("nan_plus_one bits=%s", b(mk(0xfff8000000000000UL) + 1.0));
    writefln("neg_nan_times_0 bits=%s", b(mk(0xfff8000000000000UL) * 0.0));
}
