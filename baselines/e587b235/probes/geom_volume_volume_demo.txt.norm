SweptSurfaceVolume demo
ssv=SweptSurfaceVolume(face0123=CoonsPatch(south=Line(p0=Vector3(0, 0.1, 0), p1=Vector3(1, 0.1, 0)), north=Line(p0=Vector3(0, 1.1, 0), p1=Vector3(1, 1.1, 0)), west=Line(p0=Vector3(0, 0.1, 0), p1=Vector3(0, 1.1, 0)), east=Line(p0=Vector3(1, 0.1, 0), p1=Vector3(1, 1.1, 0))), edge04=Line(p0=Vector3(0, 0.1, 0), p1=Vector3(0, 0.1, 3)))
