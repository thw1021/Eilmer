Begin demonstration of the ParametricVolume elements.
TFIVolume demo
my_vol= TFIVolume(faces=[CoonsPatch(south=Line(p0=Vector3(0, 0.1, 0), p1=Vector3(0, 1.1, 0)), north=Line(p0=Vector3(0, 0.1, 3), p1=Vector3(0, 1.1, 3)), west=Line(p0=Vector3(0, 0.1, 0), p1=Vector3(0, 0.1, 3)), east=Line(p0=Vector3(0, 1.1, 0), p1=Vector3(0, 1.1, 3))), CoonsPatch(south=Line(p0=Vector3(1, 0.1, 0), p1=Vector3(1, 1.1, 0)), north=Line(p0=Vector3(1, 0.1, 3), p1=Vector3(1, 1.1, 3)), west=Line(p0=Vector3(1, 0.1, 0), p1=Vector3(1, 0.1, 3)), east=Line(p0=Vector3(1, 1.1, 0), p1=Vector3(1, 1.1, 3))), CoonsPatch(south=Line(p0=Vector3(0, 0.1, 0), p1=Vector3(1, 0.1, 0)), north=Line(p0=Vector3(0, 0.1, 3), p1=Vector3(1, 0.1, 3)), west=Line(p0=Vector3(0, 0.1, 0), p1=Vector3(0, 0.1, 3)), east=Line(p0=Vector3(1, 0.1, 0), p1=Vector3(1, 0.1, 3))), CoonsPatch(south=Line(p0=Vector3(0, 1.1, 0), p1=Vector3(1, 1.1, 0)), north=Line(p0=Vector3(0, 1.1, 3), p1=Vector3(1, 1.1, 3)), west=Line(p0=Vector3(0, 1.1, 0), p1=Vector3(0, 1.1, 3)), east=Line(p0=Vector3(1, 1.1, 0), p1=Vector3(1, 1.1, 3))), CoonsPatch(south=Line(p0=Vector3(0, 0.1, 0), p1=Vector3(1, 0.1, 0)), north=Line(p0=Vector3(0, 1.1, 0), p1=Vector3(1, 1.1, 0)), west=Line(p0=Vector3(0, 0.1, 0), p1=Vector3(0, 1.1, 0)), east=Line(p0=Vector3(1, 0.1, 0), p1=Vector3(1, 1.1, 0))), CoonsPatch(south=Line(p0=Vector3(0, 0.1, 3), p1=Vector3(1, 0.1, 3)), north=Line(p0=Vector3(0, 1.1, 3), p1=Vector3(1, 1.1, 3)), west=Line(p0=Vector3(0, 0.1, 3), p1=Vector3(0, 1.1, 3)), east=Line(p0=Vector3(1, 0.1, 3), p1=Vector3(1, 1.1, 3)))])
my_vol(0.1, 0.1, 0.1)= Vector3(0.1, 0.2, 0.3)
